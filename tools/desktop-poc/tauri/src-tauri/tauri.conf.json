{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cornell Method Notebook Tauri PoC",
  "version": "0.1.0",
  "identifier": "com.cornellmethod.notebook.tauri.poc",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:37821/notes"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cornell Method Notebook",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Cornell Method Notebook desktop PoC",
    "longDescription": "Unselected Tauri + Node.js sidecar desktop PoC.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
