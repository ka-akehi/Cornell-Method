{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Permissions for the single primary window",
      "local": true,
      "windows": ["primary"],
      "permissions": ["core:default", "local-app-commands"]
    },
    {
      "identifier": "remote-loopback",
      "description": "Validated Settings, backup, recovery, diagnostics, and API access for the primary sidecar WebView only",
      "local": false,
      "remote": {
        "urls": ["http://127.0.0.1::port/*"]
      },
      "windows": ["primary"],
      "permissions": [
        "allow-remote-desktop-update",
        "allow-remote-desktop-data-backup",
        "allow-remote-desktop-diagnostics",
        "allow-request-desktop-state-changing-api"
      ]
    }
  ]
}
