{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cornell Method Notebook",
  "version": "0.1.0",
  "identifier": "com.cornellmethod.notebook",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build && npm run desktop:prepare-node-runtime"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Cornell Method Notebook desktop application",
    "longDescription": "A local-first Cornell Method notebook for macOS.",
    "icon": ["icons/icon.png"],
    "resources": {
      "../.desktop-runtime/node": "runtime/node",
      "../.desktop-runtime/package.json": "runtime/package.json",
      "../.desktop-runtime/node_modules/**/*": "runtime/node_modules/",
      "../.desktop-runtime/node_modules/.bin/**/*": "runtime/node_modules/.bin/",
      "../.desktop-runtime/node_modules/.prisma/**/*": "runtime/node_modules/.prisma/",
      "sidecar/launcher.cjs": "runtime/sidecar/launcher.cjs",
      "../.next/BUILD_ID": "runtime/.next/BUILD_ID",
      "../.next/*.json": "runtime/.next/",
      "../.next/server/**/*": "runtime/.next/server/",
      "../.next/static/**/*": "runtime/.next/static/",
      "../prisma/**/*": "runtime/prisma/",
      "../config/project-env.js": "runtime/config/project-env.js",
      "../src/generated/**/*": "runtime/src/generated/",
      "../src/server/infrastructure/desktop-storage.js": "runtime/src/server/infrastructure/desktop-storage.js",
      "../next.config.ts": "runtime/next.config.ts",
      "../prisma.config.ts": "runtime/prisma.config.ts",
      "../public/**/*": "runtime/public/"
    }
  }
}
